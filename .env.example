# Copy to .env and fill in your own values. Never commit the real .env file.

# --- MySQL (used by backend/db.py and scripts/) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=benti

# --- Neo4j (used by backend/db.py and scripts/) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- LLM endpoint (OpenAI-compatible, used by backend/llm_client.py) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# --- Optional: alternative provider used by scripts/generate_text_data.py ---
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
